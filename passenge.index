<!DOCTYPE html>
<html lang="zh-HK">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>乘客網上購票系統</title>
    <!-- 引入 QR Code 生成庫 -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>

    <style>
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background-color: #e9ecef; padding: 20px; }
        .container { max-width: 600px; margin: auto; background: white; padding: 20px; border-radius: 10px; box-shadow: 0 4px 8px rgba(0,0,0,0.1); }
        h1, h2 { color: #333; text-align: center; }
        .schedule-card { border: 1px solid #ddd; padding: 15px; margin-bottom: 10px; border-radius: 8px; background-color: #f8f9fa; }
        .schedule-card p { margin: 5px 0; }
        button { background-color: #28a745; color: white; border: none; padding: 10px; width: 100%; cursor: pointer; border-radius: 5px; font-size: 16px; margin-top: 10px; }
        button:hover { background-color: #218838; }
        #ticketArea { display: none; text-align: center; margin-top: 20px; padding: 20px; border: 2px solid #28a745; border-radius: 10px; }
        #qrcode { display: flex; justify-content: center; margin: 20px 0; }
    </style>
</head>
<body>
    <div class="container">
        <h1>網上購票系統</h1>
        
        <div id="scheduleList">
            <p style="text-align:center;">正在連線至 Firebase 載入最新班次...</p>
        </div>

        <div id="ticketArea">
            <h2>電子車票已生成</h2>
            <p>請在上車時出示下方二維碼供掃描驗證：</p>
            <div id="qrcode"></div>
            <p id="ticketDetails" style="font-weight: bold; white-space: pre-line;"></p>
            <button onclick="location.reload()" style="background-color: #6c757d;">返回班次列表</button>
        </div>
    </div>

    <!-- 將 type 設為 module 以支援 import 語法 -->
    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-app.js";
        import { getDatabase, ref, onValue, set } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-database.js";

        // 你的 Firebase 設定
        const firebaseConfig = {
            apiKey: "AIzaSyCq_8FSy5JU9-ETd1F3whQHwXC_fY1uqdo",
            authDomain: "admin-bus2026.firebaseapp.com",
            databaseURL: "https://admin-bus2026-default-rtdb.firebaseio.com",
            projectId: "admin-bus2026",
            storageBucket: "admin-bus2026.firebasestorage.app",
            messagingSenderId: "465878874061",
            appId: "1:465878874061:web:f967bd130caf9546abb684",
            measurementId: "G-S9FFQH5DPK"
        };

        // 初始化 Firebase
        const app = initializeApp(firebaseConfig);
        const db = getDatabase(app);

        // 即時監聽 Firebase 的班次
        const schedulesRef = ref(db, 'schedules');
        onValue(schedulesRef, (snapshot) => {
            const scheduleList = document.getElementById('scheduleList');
            scheduleList.innerHTML = "<h2>可預訂班次</h2>";
            
            if (!snapshot.exists()) {
                scheduleList.innerHTML += "<p style='text-align:center;'>目前沒有可購買的班次。</p>";
                return;
            }

            snapshot.forEach((childSnapshot) => {
                const sch = childSnapshot.val();
                const routeInfo = `${sch.origin} ➔ ${sch.destination}`;
                const timeInfo = `${sch.date} ${sch.time}`;

                let card = document.createElement('div');
                card.className = 'schedule-card';
                card.innerHTML = `
                    <p><strong>路線：</strong> ${routeInfo}</p>
                    <p><strong>時間：</strong> ${timeInfo}</p>
                    <p><strong>價格：</strong> $${sch.price}</p>
                    <button onclick="window.buyTicket('${sch.id}', '${routeInfo}', '${timeInfo}')">購買此車票</button>
                `;
                scheduleList.appendChild(card);
            });
        });

        // 購買車票並寫入 Firebase
        window.buyTicket = function(scheduleId, routeInfo, timeInfo) {
            const ticketId = 'TKT-' + Math.floor(100000 + Math.random() * 900000);
            
            const ticketData = {
                id: ticketId,
                scheduleId: scheduleId,
                routeInfo: routeInfo + ' (' + timeInfo + ')',
                used: false,
                purchasedAt: Date.now()
            };

            const newTicketRef = ref(db, 'tickets/' + ticketId);
            set(newTicketRef, ticketData).then(() => {
                document.getElementById('scheduleList').style.display = 'none';
                document.getElementById('ticketArea').style.display = 'block';
                document.getElementById('ticketDetails').innerText = `路線: ${routeInfo}\n時間: ${timeInfo}\n票號: ${ticketId}`;

                document.getElementById('qrcode').innerHTML = "";
                new QRCode(document.getElementById("qrcode"), {
                    text: ticketId,
                    width: 200,
                    height: 200,
                    colorDark : "#000000",
                    colorLight : "#ffffff",
                    correctLevel : QRCode.CorrectLevel.H
                });
            }).catch(error => {
                alert("購票失敗，請重試: " + error.message);
            });
        }
    </script>
</body>
</html>
